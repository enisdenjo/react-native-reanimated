require_relative '../node_modules/react-native-macos/scripts/react_native_pods'

ENV['IS_REANIMATED_EXAMPLE_APP'] = '1'

require_relative '../../../scripts/llvm-tools/add-xcode-step.rb'

prepare_react_native_project!

target 'MacOSExample-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :hermes_enabled => true,
    :fabric_enabled => true,
    :new_arch_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)
    # fmt 11.0.2 only disables `consteval` for Apple clang < 14, so Xcode 26+ (clang 21)
    # turns it on and then rejects fmt's own FMT_STRING calls. Force the escape for all
    # Apple clang (constexpr fallback). Drop once react-native-macos ships fmt >= 11.1.
    # Upstream: https://github.com/fmtlib/fmt/issues/4740
    # See also: https://github.com/software-mansion/react-native-executorch/issues/1081
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      patched = original.sub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      unless patched == original
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end
  end

  add_compile_metadata_step()
end
